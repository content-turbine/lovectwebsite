# Backend base URL for the Citable free-audit widget (components/citable).
# Points at the answergraph-lite API's public POST /v1/quick-audit route.
# Leave as localhost for local dev; set to the deployed API URL in
# production (Vercel project settings -> Environment Variables).
VITE_CITABLE_API_URL=http://localhost:3000

# Slack Incoming Webhook URL used by api/lead-notify.ts to post homepage
# lead-form submissions (work email only) to a Slack channel so the team
# can follow up to book a strategy call. Create one at a Slack app's
# admin page -> Incoming Webhooks -> Add New Webhook to Workspace.
# Server-side only -- do NOT prefix with VITE_, or it would be bundled
# into client JS. Set the real value via `vercel env add SLACK_WEBHOOK_URL`
# or the Vercel project's Environment Variables settings; for local dev,
# put it in .env.local (already gitignored).
SLACK_WEBHOOK_URL=
